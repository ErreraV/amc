# Copy this file to `.env` and customize the values for your machine.
# Keep repository-relative paths when possible so the project stays portable.

# Network endpoints
AMC_HOST=127.0.0.1
AMC_PORT=9001
SIONNA_HOST=127.0.0.1
SIONNA_PORT=9000
METRICS_HOST=127.0.0.1
METRICS_PORT=5001
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
METRICS_SERVER_URL=http://127.0.0.1:5001
EVENT_PUBLISHER_URL=http://127.0.0.1:5001/ingest_event

# Runtime / GPU settings
# Set CUDA_VISIBLE_DEVICES to the GPU index you want to use, or leave it empty
# if you want the runtime to use the default device selection.
CUDA_VISIBLE_DEVICES=0
SIONNA_BACKEND=pytorch
TF_CPP_MIN_LOG_LEVEL=3
TF_FORCE_GPU_ALLOW_GROWTH=true

# ns-3 / local build helpers
HOST_IP=127.0.0.1
NS3_DIR=./../ns-allinone-3.44/ns-3.44
VENVNS3=/path/to/your/virtualenv
NS3SRC=/path/to/ns-allinone-3.44/ns-3.44
CPATH=/path/to/your/virtualenv/include:$CPATH
LIBRARY_PATH=/path/to/your/virtualenv/lib:/path/to/your/virtualenv/lib64:$LIBRARY_PATH
LD_LIBRARY_PATH=/path/to/your/virtualenv/lib:/path/to/your/virtualenv/lib64:$LD_LIBRARY_PATH
PIP_SITE=/path/to/your/virtualenv/lib/python3.12/site-packages
TMUX_SESSION_NAME=pidr-sim

# Project data and model paths
GAN_TRAINING_DATA_FILE=data/gan_training_data_enhanced.json
GAN_PREPROCESSING_FILE=data/enhanced_snr_preprocessing.pkl
GAN_MODEL_PATH=models/gan/enhanced_snr_gan.pth
GAN_CONFIG_PATH=models/gan/enhanced_snr_gan_config.json
RL_MODEL_PATH=models/rl/rl_amc_model_safeguard1.pth
BENCHMARK_RESULTS_DIR=benchmarks/results