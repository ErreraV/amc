# Repository defaults discovered in code and docs.
# The project does not currently auto-load this file; use it as the single source of truth for local overrides.

# Network endpoints
AMC_HOST=127.0.0.1
AMC_PORT=9001
SIONNA_HOST=127.0.0.1
SIONNA_PORT=9000
METRICS_HOST=127.0.0.1
METRICS_PORT=5001
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
METRICS_SERVER_URL=http://127.0.0.1:5001
EVENT_PUBLISHER_URL=http://127.0.0.1:5001/ingest_event

# Runtime / GPU settings
CUDA_VISIBLE_DEVICES=0
SIONNA_BACKEND=pytorch
TF_CPP_MIN_LOG_LEVEL=3
TF_FORCE_GPU_ALLOW_GROWTH=true

# ns-3 / local build helpers
HOST_IP=127.0.0.1
NS3_DIR=./../ns-allinone-3.44/ns-3.44
VENVNS3=$HOME/tn/pidr-kd-gan/.venv
NS3SRC=$HOME/ns-allinone-3.44/ns-3.44
CPATH=$VENVNS3/include:$CPATH
LIBRARY_PATH=$VENVNS3/lib:$VENVNS3/lib64:$LIBRARY_PATH
LD_LIBRARY_PATH=$VENVNS3/lib:$VENVNS3/lib64:$LD_LIBRARY_PATH
PIP_SITE=$VENVNS3/lib/python3.12/site-packages
TMUX_SESSION_NAME=pidr-sim

# Project data and model paths
GAN_TRAINING_DATA_FILE=data/gan_training_data_enhanced.json
GAN_PREPROCESSING_FILE=data/enhanced_snr_preprocessing.pkl
GAN_MODEL_PATH=models/gan/enhanced_snr_gan.pth
GAN_CONFIG_PATH=models/gan/enhanced_snr_gan_config.json
RL_MODEL_PATH=models/rl/rl_amc_model_safeguard1.pth
BENCHMARK_RESULTS_DIR=benchmarks/results